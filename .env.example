# Copy this file to .env.local and fill in your local provider values.
# .env.local is ignored by git.

OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_BASE_URL=https://api.openai.com/v1

# If your ASR provider uses a different env var name, set it in Settings.
# The provider must expose an OpenAI-compatible /audio/transcriptions endpoint.
