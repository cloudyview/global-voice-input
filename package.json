{
  "name": "global-voice-input",
  "version": "0.1.0",
  "private": true,
  "description": "Windows global push-to-talk voice input utility.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-assets.ps1",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "electron": "^32.3.3",
    "typescript": "^5.8.3"
  }
}
